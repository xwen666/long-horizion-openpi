# Copy to a local shell file and source it. Do not commit machine-specific
# paths or tokens.

export OPENPI_WAM_ROOT="/path/to/openpi-wam"
export OPENPI_DATA_HOME="${OPENPI_WAM_ROOT}"

# OpenPI base model and LIBERO data/cache resources.
export OPENPI_PI05_BASE_PARAMS="${OPENPI_WAM_ROOT}/openpi-assets/checkpoints/pi05_base/params"
export OPENPI_LIBERO_LEROBOT_ROOT="${OPENPI_WAM_ROOT}/datasets/libero_lerobot"
export OPENPI_WORLDPILOT_LIBERO_CACHE_ROOT="${OPENPI_WAM_ROOT}/cosmos_cache/WorldPilot-LIBERO-precompute/cosmos_cache"

# Cosmos Predict/WAM runtime resources.
export COSMOS_REPO="${OPENPI_WAM_ROOT}/cosmos-predict2.5"
export COSMOS_CHECKPOINTS_DIR="${OPENPI_WAM_ROOT}/cosmos_checkpoints"
export COSMOS_POLICY_ROOT="${OPENPI_WAM_ROOT}/cosmos_checkpoints/Cosmos-Policy-LIBERO-Predict2-2B"
export COSMOS_PYTHON="${COSMOS_REPO}/.venv/bin/python"
